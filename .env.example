# Copy these into Netlify -> Site configuration -> Environment variables (mark as Secret).
# Do NOT commit a real .env file.

# --- Required ---
SESSION_SECRET=            # 32+ random characters:  openssl rand -base64 48
SETUP_CODE=                # lets you create the first administrator in the browser; delete it afterwards

# --- TEST MODE (temporary!) ---
OPEN_ACCESS=false          # true = no sign-in, everyone is administrator. Never leave on with real data.

# --- Optional: who may sign in ---
ALLOWED_EMAIL_DOMAINS=     # e.g. emergingrating.com
ALLOWED_IPS=               # e.g. 203.0.113.7, 198.51.100.0/24

# --- Optional: easier / stricter sign-in ---
MIN_PASSWORD_LENGTH=6
FORCE_PASSWORD_CHANGE=false

# --- Optional: nightly Dropbox backup (can be added later) ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/backups
BACKUP_RETENTION_DAYS=30
